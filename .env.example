# Copy to .env.local. Never commit real API keys.
RESEND_API_KEY=
# Verify notifications.ormac.nl in Resend. Recipient remains plan@ormac.nl.
CONTACT_FROM_EMAIL=Ormac <plan@notifications.ormac.nl>
# Existing widget: preserve its dashboard settings; do not create a replacement.
# Allowed hostnames must cover the website being tested, not the email subdomain.
TURNSTILE_SITE_KEY=0x4AAAAAAFIuN064zOEU1BJW
# Matching widget secret; server-only. Store directly in .env.local or Vercel.
TURNSTILE_SECRET_KEY=
CONTACT_ALLOWED_ORIGINS=https://ormac.nl,https://www.ormac.nl
