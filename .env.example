# Copy to .env.local. Never commit real API keys.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. Recipient is fixed to plan@ormac.nl.
CONTACT_FROM_EMAIL=Ormac <plan@ormac.nl>
# Create a Managed Cloudflare Turnstile widget. Disable pre-clearance.
# Register ormac.nl and www.ormac.nl; use a separate widget for localhost/127.0.0.1.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_ALLOWED_ORIGINS=https://ormac.nl,https://www.ormac.nl
